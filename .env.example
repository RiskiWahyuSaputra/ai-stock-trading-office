# Market data provider:
#   yahoo (default) — real, exchange-delayed prices via Yahoo Finance (unofficial API, no key)
#   demo            — offline simulator, every value labelled DEMO
MARKET_DATA_PROVIDER=yahoo

# News provider:
#   real (default) — Yahoo Finance news (US) + Google News RSS in Indonesian (IDX)
#   demo           — templated [DEMO] headlines
NEWS_PROVIDER=real

# Telegram order tickets (optional). New BUY setups from the autopilot are sent
# to this chat; orders are still placed by hand in the broker app.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Scheduled server scan (optional): GET /api/cron/scan with
# "Authorization: Bearer <CRON_SECRET>" sends tickets even with every tab closed.
# Generate the secret with: openssl rand -hex 32
# CRON_SECRET=
# Upstash Redis remembers which setups were already sent. The Vercel
# Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN instead.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# What the server scan analyses (the browser settings are not visible to it):
# SIGNAL_MARKET=IDX
# SIGNAL_MODE=balanced
# SIGNAL_ACCOUNT_SIZE=100000000
# SIGNAL_RISK_PCT=1
# SIGNAL_WATCHLIST=BBCA,TLKM

# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
# LLM_API_KEY=
